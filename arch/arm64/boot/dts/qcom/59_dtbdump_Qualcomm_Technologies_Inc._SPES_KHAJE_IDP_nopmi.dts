				compatible = "qcom,cam-res-mgr";
				status = "ok";
				phandle = <0x2d>;
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";

			wl2866d@28 {
				compatible = "ovti,wl2866d-i2c";
				reg = <0x28>;
				id_reg = <0x03>;
				id_val = <0x64>;
				id_val1 = <0x55>;
